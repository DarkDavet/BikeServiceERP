<Page x:Class="BusinessAccountantService.ServiceListPage"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       xmlns:local="clr-namespace:BusinessAccountantService.Managers"
       mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="900"
       Title="ServiceListPage">

    <Page.Resources>
        <local:PriceToDashConverter x:Key="PriceToDashConverter"/>

        <!-- Стиль для современных кнопок страницы -->
        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="38"/>
            <Setter Property="Padding" Value="15,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="6"/>
                </Style>
            </Style.Resources>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.9"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Шапка -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Поиск -->
            <RowDefinition Height="*"/>
            <!-- 2: Таблица -->
            <RowDefinition Height="Auto"/>
            <!-- 3: Кнопки -->
            </Grid.RowDefinitions>

        <!-- РЯД 0: ШАПКА И ПОИСК (В стиле ClientsPage) -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="СЕРВИСЫ" FontSize="24" FontWeight="Black" Foreground="#2C3E50"/>
            </StackPanel>

            <Border Grid.Column="1" x:Name="SearchBorder" 
                    Background="White" CornerRadius="10" 
                    HorizontalAlignment="Right" Padding="8,2" 
                    BorderBrush="#DCDDE1" BorderThickness="1.5" Width="280">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Иконка лупы -->
                    <TextBlock Text="🔍" Grid.Column="0" VerticalAlignment="Center" 
                               Margin="5,0" Foreground="#BDC3C7" FontSize="14"/>

                    <!-- Текст-подсказка (исчезает при вводе) -->
                    <TextBlock Text="Поиск по услугам..." Grid.Column="1" 
                               VerticalAlignment="Center" Margin="5,0" Foreground="#BDC3C7" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- Само поле ввода -->
                    <TextBox x:Name="SearchBox" Grid.Column="1" 
                              BorderThickness="0" Background="Transparent" 
                              VerticalContentAlignment="Center" FontSize="13"
                              TextChanged="SearchBox_TextChanged" Padding="5,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- РЯД 2: ТАБЛИЦА (В белой карточке) -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#DCDDE1" BorderThickness="1" Padding="5">
            <DataGrid x:Name="ServicesGrid" AutoGenerateColumns="False" CanUserAddRows="False" 
                      IsReadOnly="True" GridLinesVisibility="Horizontal" RowHeight="35" HeadersVisibility="Column"
                      BorderThickness="0" Background="Transparent" HorizontalGridLinesBrush="#F1F2F6"
                      MouseDoubleClick="ServicesGrid_MouseDoubleClick">
                <DataGrid.Resources>
                    <!-- Стиль, который центрирует текст во всех колонках по вертикали -->
                    <Style TargetType="DataGridCell">
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                                        <ContentPresenter VerticalAlignment="Center" Margin="5,0"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Услуга" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Цена" Binding="{Binding Price, Converter={StaticResource PriceToDashConverter}}" Width="120"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- РЯД 3: КНОПКИ (Стиль ActionButtonStyle) -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="+ НОВАЯ УСЛУГА" Style="{StaticResource ActionButtonStyle}" Background="#27AE60" Click="AddService_Click" Margin="0,0,10,0"/>
                <Button Content="ИЗМЕНИТЬ" Style="{StaticResource ActionButtonStyle}" Background="#3498DB" Click="EditService_Click" Margin="0,0,10,0"/>
                <Button Content="УДАЛИТЬ" Style="{StaticResource ActionButtonStyle}" Background="#E74C3C" Click="DeleteService_Click" Margin="0,0,10,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>